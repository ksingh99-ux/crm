<section class="section">
  <h1 class="title">All Customers</h1>

  <p class="mb-4">
    <%= link_to "Alphabetized", customers_alphabetized_path, class: "button is-link" %>
    <%= link_to "Missing Email", customers_missing_email_path, class: "button is-warning" %>
  </p>

  <div class="columns is-multiline">
    <% @customers.each do |customer| %>
      <%= render "customers/customer", customer: customer %>
    <% end %>
  </div>
</section>